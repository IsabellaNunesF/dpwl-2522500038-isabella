RewriteEngine On
RewriteBase /dpwl-2522500038/
# Jangan meneruskan berkas atau direktori fisik ke Router.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
# Teruskan URL aplikasi ke front controller.
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]
# Foto KTP/SIM dari HP biasanya 2-5 MB; naikkan batas PHP bawaan (2 MB) agar upload tidak gagal.
<IfModule mod_php.c>
  php_value upload_max_filesize 6M
  php_value post_max_size 14M
</IfModule>
<IfModule mod_php8.c>
  php_value upload_max_filesize 6M
  php_value post_max_size 14M
</IfModule>