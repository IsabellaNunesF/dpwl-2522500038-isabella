# Bukti transfer bersifat privat: hanya dilayani lewat controller (transaksi/bukti)
# setelah pemeriksaan hak akses (admin atau pemilik transaksi).
Options -Indexes
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
